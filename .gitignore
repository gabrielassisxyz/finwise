node_modules/
web/dist/

# Working area of the design pipeline: the prototype bundle, candidate
# screenshots and diff heatmaps. Only the reference screenshots are versioned.
work/

# The binary `go build ./cmd/finwise` leaves in the working directory, and the one
# a plain `go build` leaves beside the command's source.
/finwise
/cmd/finwise/finwise

# Databases hold personal financial data, and so does the copy of the app's
# database taken before a migration (finwise.db.before-<UTC timestamp>).
*.db
*.db-*
*.db.before-*

.env
.env.*

# Agent tooling a contributor installs for their own use: skills, settings.
# It belongs to the machine, not to the project.
.claude/

# bv (beads viewer) local config and caches
.bv/

# The interface built into the program. The image build and the documented local
# command copy it here; only the placeholder that lets the program build without
# it is versioned.
/internal/webui/dist/*
!/internal/webui/dist/index.html

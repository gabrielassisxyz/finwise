{
  "name": "finwise-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "check:tokens": "node scripts/check-token-usage.mjs",
    "parity": "node scripts/parity/run.mjs",
    "parity:reference": "node scripts/parity/reference.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "style-dictionary": "5.8.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}

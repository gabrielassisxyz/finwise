#!/usr/bin/env bash
# The exact checks CI runs, runnable locally, so "green locally" means "green in CI".
# Keep in step with .github/workflows/ci.yml.
#
# Every gate either runs or fails loudly: a missing tool is a failure that names its
# install command, never a silent skip.
set -euo pipefail

cd "$(dirname "$0")/.."
fail=0

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing: $1 (install with: $2)"
    fail=1
    return 1
  fi
}

step() {
  local label="$1"
  shift
  echo "==> $label"
  "$@" || { echo "  FAILED: $label"; fail=1; }
}

echo "==> secret scan (gitleaks, working tree)"
if need gitleaks "https://github.com/gitleaks/gitleaks#installing"; then
  gitleaks dir . --no-banner --redact || { echo "  FAILED: gitleaks"; fail=1; }
fi

echo "==> shell scripts lint clean (shellcheck)"
if need shellcheck "https://www.shellcheck.net"; then
  shellcheck bin/ci || { echo "  FAILED: shellcheck"; fail=1; }
fi

# `go build` run inside a command's own directory leaves the program beside its
# source, where a broad `git add` picks it up: megabytes that stay in the history
# for good. The first bytes say what a file is, whatever it is called.
no_built_program_is_tracked() {
  local path found=0
  while IFS= read -r -d '' path; do
    case "$(head -c 4 "$path" 2>/dev/null | od -An -tx1 | tr -d ' \n')" in
      7f454c46 | cffaedfe | cefaedfe | feedfacf | feedface)
        echo "  $path is a built program: git rm --cached it and add it to .gitignore"
        found=1
        ;;
    esac
  done < <(git ls-files -z)
  return "$found"
}

step "no built program is tracked" no_built_program_is_tracked

if [ ! -d web/node_modules ]; then
  echo "missing: web/node_modules (install with: npm --prefix web ci)"
  echo "bin/ci FAILED"
  exit 1
fi

# The built variables are versioned so the app builds without a token step; this
# is what keeps them from drifting away from the token source. The comparison is
# against the file as it was on disk, not against git, so a token change that is
# built but not yet committed passes.
tokens_are_current() {
  local built=web/src/styles/tokens.css before
  before=$(cat "$built")
  npm --prefix web run --silent tokens >/dev/null || return 1
  if [ "$before" != "$(cat "$built")" ]; then
    echo "  $built was stale and has been rebuilt; commit it"
    return 1
  fi
}

step "design tokens are built and current" tokens_are_current
step "no raw design value outside the tokens" npm --prefix web run --silent check:tokens
step "API contract manifest is current" npm --prefix web run --silent contract:check
step "types (vue-tsc)" npm --prefix web run --silent typecheck
step "tests (vitest)" npm --prefix web run --silent test
step "build (vite)" npm --prefix web run --silent build
step "build for real use leaves the stand-in out (bundle sentinel)" npm --prefix web run --silent check:bundle

# gofmt -l exits 0 whatever it finds, so the gate is its output being empty.
go_is_formatted() {
  local dirs unformatted
  mapfile -t dirs < <(go list -f '{{.Dir}}' ./...)
  unformatted=$(gofmt -l "${dirs[@]}")
  if [ -n "$unformatted" ]; then
    echo "  gofmt would change:"
    echo "$unformatted"
    return 1
  fi
}

if need go "https://go.dev/doc/install"; then
  step "go formatting (gofmt)" go_is_formatted
  step "go vet" go vet ./...
  step "go tests" go test ./...
  step "go build" go build ./...
fi

if [ "$fail" -ne 0 ]; then
  echo "bin/ci FAILED"
  exit 1
fi
echo "CI green."

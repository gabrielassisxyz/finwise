{
  "color": {
    "$type": "color",
    "surface": {
      "page": { "$value": { "colorSpace": "oklch", "components": [0.982, 0.004, 150] }, "$description": "Page background" },
      "nav": { "$value": { "colorSpace": "oklch", "components": [0.995, 0.002, 150] }, "$description": "Sidebar, header, bottom bar, table footer. The prototype used 0.99 lightness for the footer; unified." },
      "card": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] }, "$description": "Cards, tables, inputs, menus" },
      "head": { "$value": { "colorSpace": "oklch", "components": [0.985, 0.003, 150] }, "$description": "Table header, tax sub-row" },
      "hover-row": { "$value": { "colorSpace": "oklch", "components": [0.985, 0.004, 150] }, "$description": "Hover of a table row and of a clickable card" },
      "hover-nav": { "$value": { "colorSpace": "oklch", "components": [0.955, 0.008, 150] }, "$description": "Hover of a navigation item and of an icon button" },
      "hover-item": { "$value": { "colorSpace": "oklch", "components": [0.965, 0.006, 150] }, "$description": "Hover of a keypad key, a menu item and a filter button. The prototype used 0.97 0.004 for the last; unified." },
      "pressed": { "$value": { "colorSpace": "oklch", "components": [0.94, 0.012, 155] }, "$description": "Keypad key while pressed, hover of a budget line pill" },
      "track": { "$value": { "colorSpace": "oklch", "components": [0.95, 0.005, 150] }, "$description": "Progress bar track, skeleton. The prototype used 0.96 lightness for one skeleton bar; unified." },
      "pill": { "$value": { "colorSpace": "oklch", "components": [0.965, 0.004, 150] }, "$description": "Budget line pill" },
      "count": { "$value": { "colorSpace": "oklch", "components": [0.955, 0.005, 150] }, "$description": "Tab counter, tag" },
      "toast": { "$value": "{color.text.ink}", "$description": "Toast" },
      "toast-button": { "$value": { "colorSpace": "oklch", "components": [0.34, 0.015, 155] }, "$description": "Action inside a toast" },
      "toast-button-hover": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.02, 155] }, "$description": "Hover of an action inside a toast" },
      "switch-off": { "$value": { "colorSpace": "oklch", "components": [0.84, 0.008, 150] }, "$description": "Track of a switch that is off" }
    },
    "border": {
      "default": { "$value": { "colorSpace": "oklch", "components": [0.92, 0.006, 150] }, "$description": "Card, sidebar, header" },
      "input": { "$value": { "colorSpace": "oklch", "components": [0.9, 0.006, 150] }, "$description": "Input, month selector, keypad key" },
      "button": { "$value": { "colorSpace": "oklch", "components": [0.91, 0.006, 150] }, "$description": "Secondary button, badge, menu" },
      "divider": { "$value": { "colorSpace": "oklch", "components": [0.94, 0.005, 150] }, "$description": "Divider inside a card" },
      "row": { "$value": { "colorSpace": "oklch", "components": [0.95, 0.004, 150] }, "$description": "Table row separator" },
      "strong": { "$value": { "colorSpace": "oklch", "components": [0.88, 0.008, 150] }, "$description": "Floating bar, pill border, dot of an unset line. The prototype used 0.85 lightness for the dot; unified." },
      "dot": { "$value": { "colorSpace": "oklch", "components": [0.75, 0.01, 155] }, "$description": "Empty PIN dot" }
    },
    "text": {
      "ink": { "$value": { "colorSpace": "oklch", "components": [0.24, 0.012, 155] }, "$description": "Main text" },
      "ink-2": { "$value": { "colorSpace": "oklch", "components": [0.45, 0.01, 155] }, "$description": "Secondary text, inactive navigation, an unset budget line. The prototype used 0.48 lightness for the last; unified." },
      "ink-3": { "$value": { "colorSpace": "oklch", "components": [0.4, 0.01, 155] }, "$description": "Secondary button label, tag text. The prototype used 0.38 lightness for the tag; unified." },
      "muted": { "$value": { "colorSpace": "oklch", "components": [0.52, 0.01, 155] }, "$description": "Labels, inactive tabs, table header, dates. The prototype also used 0.5 lightness for some of these; unified." },
      "muted-2": { "$value": { "colorSpace": "oklch", "components": [0.55, 0.01, 155] }, "$description": "Raw bank description, captions" },
      "placeholder": { "$value": { "colorSpace": "oklch", "components": [0.62, 0.01, 155] }, "$description": "Input placeholder" },
      "pill": { "$value": { "colorSpace": "oklch", "components": [0.32, 0.01, 155] }, "$description": "Budget line pill text" },
      "on-accent": { "$value": "{color.surface.card}", "$description": "Text over the accent or over the toast" }
    },
    "accent": {
      "base": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.1, 155] }, "$description": "Primary button, active tab, progress bar, switch on" },
      "hover": { "$value": { "colorSpace": "oklch", "components": [0.44, 0.1, 155] }, "$description": "Hover of the primary button" },
      "logo": { "$value": { "colorSpace": "oklch", "components": [0.52, 0.1, 155] }, "$description": "Logo" },
      "link": { "$value": { "colorSpace": "oklch", "components": [0.48, 0.1, 155] }, "$description": "Links and text actions" },
      "link-hover": { "$value": { "colorSpace": "oklch", "components": [0.38, 0.1, 155] }, "$description": "Hover of a link" },
      "positive": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.1, 155] }, "$description": "Incoming amounts, done state, active phone tab" },
      "tint": { "$value": { "colorSpace": "oklch", "components": [0.95, 0.015, 155] }, "$description": "Active navigation item, chip, toggle on" },
      "tint-border": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.05, 155] }, "$description": "Border of a toggle that is on" },
      "card": { "$value": { "colorSpace": "oklch", "components": [0.975, 0.012, 155] }, "$description": "Pay-ahead card, the net-worth total and the bucket card that is open. The prototype used 0.008 chroma for the last; unified." },
      "badge-bg": { "$value": { "colorSpace": "oklch", "components": [0.96, 0.02, 155] }, "$description": "Green badge background" },
      "badge-border": { "$value": { "colorSpace": "oklch", "components": [0.9, 0.04, 155] }, "$description": "Green badge border, and the rule beside a history step. The prototype used 0.02 chroma for the rule; unified." },
      "sync-dot": { "$value": { "colorSpace": "oklch", "components": [0.6, 0.1, 155] }, "$description": "Sync indicator dot" },
      "ink": { "$value": { "colorSpace": "oklch", "components": [0.3, 0.06, 155] }, "$description": "Text over the accent tint: a toggle that is on, a filter chip. The prototype used 0.04 chroma for the chip; unified." },
      "card-label": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.06, 155] }, "$description": "Label on the pay-ahead card" },
      "card-hover": { "$value": { "colorSpace": "oklch", "components": [0.96, 0.018, 155] }, "$description": "Hover of the pay-ahead card" }
    },
    "chart": {
      "1": { "$value": { "colorSpace": "oklch", "components": [0.84, 0.06, 155] }, "$description": "Chart: available" },
      "2": { "$value": { "colorSpace": "oklch", "components": [0.68, 0.09, 155] }, "$description": "Chart: reserved" },
      "3": { "$value": "{color.accent.base}", "$description": "Chart: invested" },
      "plan": { "$value": { "colorSpace": "oklch", "components": [0.84, 0.03, 155] }, "$description": "Bar of a planned amount, behind the done one" }
    },
    "warn": {
      "text": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.1, 70] }, "$description": "Warning text, pending state" },
      "bg": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.025, 80] }, "$description": "Amber badge or notice background" },
      "border": { "$value": { "colorSpace": "oklch", "components": [0.9, 0.05, 80] }, "$description": "Amber badge or notice border" },
      "notice-text": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.09, 70] }, "$description": "Text inside an amber notice, darker than the warning text used on its own" },
      "field-border": { "$value": { "colorSpace": "oklch", "components": [0.75, 0.1, 70] }, "$description": "Border of a field that still needs an answer" }
    },
    "bad": {
      "text": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.1, 25] }, "$description": "Overspend, PIN error, cancel status" },
      "bg": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.015, 25] }, "$description": "Red badge background" },
      "border": { "$value": { "colorSpace": "oklch", "components": [0.9, 0.04, 25] }, "$description": "Red badge border" }
    },
    "overlay": {
      "panel": { "$value": { "colorSpace": "oklch", "components": [0.24, 0.012, 155], "alpha": 0.25 }, "$description": "Behind the transaction panel" },
      "sheet": { "$value": { "colorSpace": "oklch", "components": [0.24, 0.012, 155], "alpha": 0.2 }, "$description": "Behind the phone navigation sheet" },
      "dialog": { "$value": { "colorSpace": "oklch", "components": [0.24, 0.012, 155], "alpha": 0.35 }, "$description": "Behind a confirmation dialog" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Geist Variable", "Geist", "system-ui", "sans-serif"], "$description": "Everything but counters and raw bank text" },
      "mono": { "$value": ["Geist Mono Variable", "Geist Mono", "ui-monospace", "monospace"], "$description": "Numeric counters and the raw bank description" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "title": { "$value": { "value": 24, "unit": "px" }, "$description": "Screen title, keypad digit" },
      "value": { "$value": { "value": 22, "unit": "px" }, "$description": "Figure on a card" },
      "section": { "$value": { "value": 15, "unit": "px" }, "$description": "Section title, app name" },
      "body": { "$value": { "value": 14, "unit": "px" }, "$description": "Body, table rows, buttons, tabs" },
      "secondary": { "$value": { "value": 13, "unit": "px" }, "$description": "Secondary text, filters" },
      "caption": { "$value": { "value": 12, "unit": "px" }, "$description": "Table header, captions, pills" },
      "badge": { "$value": { "value": 11, "unit": "px" }, "$description": "Badges, raw bank description" },
      "micro": { "$value": { "value": 10, "unit": "px" }, "$description": "Counter on the phone navigation" },
      "panel-title": { "$value": { "value": 20, "unit": "px" }, "$description": "Name and amount at the head of the transaction panel" }
    },
    "tracking": {
      "$type": "number",
      "tight": { "$value": -0.02, "$description": "Letter spacing of titles and figures, in em" },
      "snug": { "$value": -0.01, "$description": "Letter spacing of the app name, in em" }
    }
  },
  "radius": {
    "$type": "dimension",
    "bar": { "$value": { "value": 4, "unit": "px" }, "$description": "Progress bar" },
    "badge": { "$value": { "value": 5, "unit": "px" }, "$description": "Rectangular badges, closed-month seal" },
    "item": { "$value": { "value": 6, "unit": "px" }, "$description": "Menu item" },
    "nav": { "$value": { "value": 7, "unit": "px" }, "$description": "Navigation item, small logo, sync notice" },
    "control": { "$value": { "value": 8, "unit": "px" }, "$description": "Inputs, buttons, month selector" },
    "card": { "$value": { "value": 10, "unit": "px" }, "$description": "Cards, tables, menus, toast, large logo" },
    "dialog": { "$value": { "value": 12, "unit": "px" }, "$description": "Confirmation dialog, switch track, phone sheet" },
    "pill": { "$value": { "value": 20, "unit": "px" }, "$description": "Budget line pill, filter chip" }
  },
  "space": {
    "$type": "dimension",
    "2": { "$value": { "value": 2, "unit": "px" } },
    "4": { "$value": { "value": 4, "unit": "px" } },
    "6": { "$value": { "value": 6, "unit": "px" } },
    "8": { "$value": { "value": 8, "unit": "px" } },
    "10": { "$value": { "value": 10, "unit": "px" } },
    "12": { "$value": { "value": 12, "unit": "px" } },
    "14": { "$value": { "value": 14, "unit": "px" } },
    "16": { "$value": { "value": 16, "unit": "px" } },
    "20": { "$value": { "value": 20, "unit": "px" } },
    "24": { "$value": { "value": 24, "unit": "px" } },
    "36": { "$value": { "value": 36, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "popover": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.3, 0.02, 155], "alpha": 0.22 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 12, "unit": "px" },
        "blur": { "value": 32, "unit": "px" },
        "spread": { "value": -8, "unit": "px" }
      },
      "$description": "Menu, floating selection bar, phone sheet. The prototype used 0.2, 0.22 and 0.25 alpha for these three; unified."
    },
    "toast": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2, 0.02, 155], "alpha": 0.4 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 12, "unit": "px" },
        "blur": { "value": 32, "unit": "px" },
        "spread": { "value": -8, "unit": "px" }
      },
      "$description": "Toast"
    },
    "panel": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.3, 0.02, 155], "alpha": 0.2 },
        "offsetX": { "value": -16, "unit": "px" },
        "offsetY": { "value": 0, "unit": "px" },
        "blur": { "value": 40, "unit": "px" },
        "spread": { "value": -16, "unit": "px" }
      },
      "$description": "Side panel"
    },
    "dialog": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2, 0.02, 155], "alpha": 0.4 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 24, "unit": "px" },
        "blur": { "value": 60, "unit": "px" },
        "spread": { "value": -12, "unit": "px" }
      },
      "$description": "Confirmation dialog"
    }
  },
  "duration": {
    "$type": "duration",
    "switch": { "$value": { "value": 150, "unit": "ms" }, "$description": "Switch thumb" },
    "shake": { "$value": { "value": 400, "unit": "ms" }, "$description": "PIN dots after a wrong PIN" }
  }
}
